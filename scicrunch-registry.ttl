    rdfs:label "DNASTAR: Lasergene Genomics Suite" ;
    NIFRID:abbrev "Lasergene Genomics Suite" ;
    definition: "Software for next-gen sequence assembly and analysis in a single, integrated package." .

SCR:011855 a NLX:152342,
