    rdfs:label "Rigaku | AZX 400" ;
    definition: "Sequential wavelength dispersive XRF spectrometer for large samples film thickness and composition measurements on large and heavy samples, wafers, and media disks." .

SCR:020440 a NLX:63400,
        owl:NamedIndividual ;
    oboInOwl:hasDbXref "Model_Number_MFM310" ;
    rdfs:label "Rigaku | MFM310" ;
    definition: "X-ray metrology tool to perform high throughput measurements on product and blanket wafers ranging from ultrathin single layer films to multilayer stacks." .

SCR:020441 a NLX:63400,
        owl:NamedIndividual ;
