    oboInOwl:hasDbXref "OMICS_02566" ;
    rdfs:label "ParseCNV" ;
    definition: "Software that takes CNV calls as input and creates SNP based statistics for CNV occurrence in cases and controls then calls CNVRs based on neighboring SNPs of similar significance." .

SCR:000356 a NLX:63400,
