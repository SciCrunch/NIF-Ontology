    rdfs:label "pyGCluster" ;
    definition: "A clustering algorithm focusing on noise injection for subsequent cluster validation." .

SCR:011945 a NLX:63400,
        owl:NamedIndividual ;
    oboInOwl:hasDbXref "biotools:cancerresource",
        "OMICS_01576" ;
    rdfs:label "CancerResource" ;
    definition: "Comprehensive database of cancer relevant proteins and compound interactions supported by experimental knowledge.Knowledgebase for drug-target relationships related to cancer as well as for supporting information or experimental data." .

SCR:011946 a NLX:63400,
        owl:NamedIndividual ;
    oboInOwl:hasDbXref "OMICS_01680" ;
    rdfs:label "ARTIVA" ;
    NIFRID:synonym "Auto Regressive TIme VArying regulatory models" ;
    definition: "Algorithm available in a R package that is a statistical framework to infer time-varying structures of gene-regulation networks." .

SCR:011947 a NLX:63400,
        owl:NamedIndividual ;
    oboInOwl:hasDbXref "OMICS_01518" ;
    rdfs:label "mothur" ;
    definition: "An open-source software package for describing and comparing microbial communities. It incorporates the functionality of a number of computational tools, calculators, and visualization tools." .

SCR:011949 a NLX:152342,
