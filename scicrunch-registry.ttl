    rdfs:label "Ludwig-Maximilians-University; Munich; Germany" ;
    NIFRID:synonym "LMU Munich",
        "Ludwig-Maximilian-University",
        "Ludwig-Maximilian-University Munich; Munich; Germany",
        "Ludwig-Maximilians-Universitat Munchen",
        "Ludwig-Maximilians-University; Bavaria; Germany" ;
    NIFRID:abbrev "LMU" ;
