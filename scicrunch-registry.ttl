    definition: "AUTION MAX AX-4030 generates accurate and reliable urine chemistry results without interruption and offers high throughput and continuous loading." .

SCR:019618 a NLX:63400,
        owl:NamedIndividual ;
    oboInOwl:hasDbXref "Model_Number_Biomek_4000" ;
    rdfs:label "Beckman Coulter | Biomek 4000 Automated Liquid Handler" ;
