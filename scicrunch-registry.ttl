        "Wikidata:Q866012" ;
    rdfs:label "University of Queensland; Brisbane; Australia" ;
    NIFRID:synonym "University of Queensland" ;
    NIFRID:abbrev "UQ" ;
    definition: "Public research university located primarily in Brisbane, the capital city of the Australian state of Queensland. Founded in 1909 by the Queensland parliament, UQ is one of the six sandstone universities, an informal designation of the oldest university in each state." .

SCR:012962 a NLX:63400,
