    rdfs:label "Aston University; Birmingham; United Kingdom" ;
    NIFRID:synonym "Aston University" ;
    definition: "Public research university situated in the city centre of Birmingham, England. Aston began as the Birmingham Municipal Technical School in 1895, evolving into the UK's first College of Advanced Technology in 1956" .

SCR:011099 a NLX:152328,
        owl:NamedIndividual ;
