SCR:011994 a NLX:63400,
        owl:NamedIndividual ;
    oboInOwl:hasDbXref "OMICS_01765" ;
    rdfs:label "1DegreeBio" ;
    NIFRID:synonym "1degreebio",
        "1degreebio.org" ;
    definition: "A registry which provides links and reviews for material resources such as reagents, equipment, digital tools, and providers, as well as the companies that sell them. Users can search for specific materials or search by vendor, product, or service type." .

SCR:011995 a NLX:63400,
