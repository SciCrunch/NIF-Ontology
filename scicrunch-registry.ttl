    definition: "Modular leak testing package is used for applications in which leak detector components are more or less permanently mounted to system." .

SCR:019566 a NLX:63400,
        owl:NamedIndividual ;
    oboInOwl:hasDbXref "Model_Number_ISS Chronos" ;
