CHEBI:49205 a owl:Class ;
    oboInOwl:hasDbXref "wikipedia.en:CETP_inhibitor" ;
    rdfs:label "CETP inhibitor" ;
    definition: "Any inhibitor of cholesterylester transfer protein (CETP), which transfers cholesterol from high density lipoproteins (HDL, the 'good' cholesterol-containing particles) to low or very low density lipoproteins (LDL or VLDL, the 'bad' cholesterol-containing particles). Inhibition of this process results in higher HDL levels and lower LDL levels. CETP inhibitors are under investigation as potential drugs to reduce the risk of arteriosclerotic vascular disease (atherosclerosis)." ;
    rdfs:subClassOf CHEBI:35222,
        CHEBI:52206 ;
    oboInOwl:hasOBONamespace "chebi_ontology" ;
    oboInOwl:hasRelatedSynonym "CETP inhibitors",
        "cholesteryl ester transfer protein inhibitor" ;
    oboInOwl:id "CHEBI:49205" ;
    oboInOwl:inSubset chebi:3_STAR .

