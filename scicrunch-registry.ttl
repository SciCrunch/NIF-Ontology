    NIFRID:synonym "FusionHunter: identifying fusion transcripts using paired-end RNA-seq" ;
    definition: "A perl-based software package, which can be used to find fusion transcript candidates in RNA-Seq data." .

SCR:011895 a NLX:63400,
        owl:NamedIndividual ;
