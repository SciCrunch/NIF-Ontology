SCR:010766 a NLX:63400,
        owl:NamedIndividual ;
    oboInOwl:hasDbXref "OMICS_00114" ;
    rdfs:label "SSRLocator" ;
    NIFRID:synonym "Simple Sequence Repeat Locator",
        "SSR Locator",
        "SSR Locator - Simple Sequence Repeat Locator" ;
