    rdfs:label "HomSI" ;
    NIFRID:synonym "Homozygous Stretch Identifier from next-generation sequencing data",
        "HomSI - Homozygous Stretch Identifier from next-generation sequencing data" ;
    definition: "A software tool that identifies homozygous regions using deep sequence data." .

SCR:010772 a NLX:63400,
        owl:NamedIndividual ;
    oboInOwl:hasDbXref "OMICS_00125" ;
    rdfs:label "Align-GVGD" ;
    definition: "A freely available, web-based program that combines the biophysical characteristics of amino acids and protein multiple sequence alignments to predict where missense substitutions in genes of interest fall in a spectrum from enriched delterious to enriched neutral." .

SCR:010773 a NLX:63400,
        owl:NamedIndividual ;
    oboInOwl:hasDbXref "biotools:cupsat",
