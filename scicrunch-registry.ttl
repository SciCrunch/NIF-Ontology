    rdfs:label "Marquette University College of Health Sciences; Wisconsin; USA" .

SCR:011364 a owl:NamedIndividual ;
    oboInOwl:hasDbXref "nlx_29646" ;
    rdfs:label "Marshall University Joan C. Edwards School of Medicine; West Virginia; USA" ;
    NIFRID:synonym "Marshall University JCESOM" ;
    NIFRID:abbrev "JCESOM" ;
    definition: "At Marshall University, the Joan C. Edwards School of Medicine blends high-quality medical education and graduate education with a distinctive hands-on approach to meeting the health care needs of West Virginians and others who live in the nation''s rural areas. Marshall produces skilled, confident graduates who are successful in generalist and subspecialty medicine." .

SCR:011365 a NLX:152328,
