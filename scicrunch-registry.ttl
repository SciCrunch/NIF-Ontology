SCR:011470 a NLX:152328,
        owl:NamedIndividual ;
    oboInOwl:hasDbXref "GRID: grid.16753.36; ISNI: 0000 0001 2299 3507; Crossref Funder ID: 100007059; Wikidata: Q309350",
        "nlx_95740" ;
    rdfs:label "Northwestern University; Illinois; USA" ;
    definition: "Private research university in Evanston, Illinois, United States. Established in 1851 to serve the historic Northwest Territory, it is the oldest chartered university in Illinois. The university has its main campus along the shores of Lake Michigan in the Chicago metropolitan area." .

SCR:011471 a NLX:152328,
        owl:NamedIndividual ;
    oboInOwl:hasDbXref "Crossref Funder ID 100007703",
