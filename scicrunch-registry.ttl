    rdfs:label "SNP and Variation Suite" ;
    NIFRID:abbrev "SNP & Variation Suite" ;
    definition: "An integrated collection of user-friendly, yet powerful analytic tools for managing, analyzing, and visualizing multifaceted genomic and phenotypic data." .

SCR:011857 a NLX:152342,
        owl:NamedIndividual ;
