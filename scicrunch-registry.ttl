    rdfs:label "Florey Institute of Neuroscience and Mental Health; Victoria; Australia" ;
    NIFRID:synonym "Florey Institute of Neuroscience and Mental Health",
        "The Florey" ;
    NIFRID:abbrev "Florey" ;
    definition: "One of the world''s top 10 brain research centres. Their scientists comprise the largest neuroscience research team in Australia." .

SCR:011225 a NLX:152328,
        owl:NamedIndividual ;
