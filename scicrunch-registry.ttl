    NIFRID:synonym "Bioinformatics Core",
        "UKE",
        "University Medical Center Hamburg Eppendorf Core" ;
    NIFRID:abbrev "UKE Bioinformatics Core" ;
    definition: "Core provides bioinformatics services for researchers at University Medical Center Hamburg Eppendorf  and related institutions. Focusing on high throughput sequencing data. Services include data analysis, consulting, software development, and bioinformatical training." .

SCR:017145 a NLX:63400,
        owl:NamedIndividual ;
