SCR:010572 a NLX:63400,
        owl:NamedIndividual ;
    oboInOwl:hasDbXref "nlx_41642" ;
    rdfs:label "MirAlign" ;
    definition: "An online tool to identify homologous miRNA genes. This tool can search for new miRNA candidates by requiring structural similarity and sequence conservations between new candidates and experimentally identified miRNAs. Simply Input your sequence and parameters." .

SCR:010573 a NLX:63400,
        owl:NamedIndividual ;
