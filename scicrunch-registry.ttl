    definition: "THIS RESOURCE IS NO LONGER IN SERVICE. Documented on April 16,2024. Portal, Core facility" .

SCR:012657 a NLX:63400,
        owl:NamedIndividual ;
    oboInOwl:hasDbXref "SciEx_754" ;
