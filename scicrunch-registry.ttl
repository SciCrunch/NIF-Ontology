    NIFRID:synonym "Cologne University Protein Stability Analysis Tool",
        "CUPSAT: Cologne University Protein Stability Analysis Tool" ;
    definition: "A tool to predict changes in protein stability upon point mutations." .

SCR:010774 a NLX:63400,
        owl:NamedIndividual ;
    oboInOwl:hasDbXref "biotools:ls-snp",
        "OMICS_00131" ;
    rdfs:label "LS-SNP/PDB" ;
    definition: "A web tool for genome-wide annotation of human SNPs." .

SCR:010775 a NLX:63400,
        owl:NamedIndividual ;
    oboInOwl:hasDbXref "OMICS_00132" ;
    rdfs:label "MAPP" ;
    NIFRID:synonym "Multivariate Analysis of Protein Polymorphism",
        "Multivariate Analysis of Protein Polymorphism:MAPP" ;
    definition: "Java program that predicts the impact of all possible amino acid substitutions on the function of the protein., THIS RESOURCE IS NO LONGER IN SERVICE. Documented on September 16,2025." .

SCR:010776 a NLX:63400,
        owl:NamedIndividual ;
