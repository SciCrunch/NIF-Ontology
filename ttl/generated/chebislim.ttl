CHEBI:35493 a owl:Class ;
    oboInOwl:hasDbXref "wikipedia.en:Antipyretic" ;
    rdfs:label "antipyretic" ;
    definition: "A drug that prevents or reduces fever by lowering the body temperature from a raised state. An antipyretic will not affect the normal body temperature if one does not have fever. Antipyretics cause the hypothalamus to override an interleukin-induced increase in temperature. The body will then work to lower the temperature and the result is a reduction in fever." ;
    rdfs:subClassOf CHEBI:23888 ;
    oboInOwl:hasOBONamespace "chebi_ontology" ;
