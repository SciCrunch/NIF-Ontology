    definition: "Clinical chemistry analyzers processes up to 2,000 tests per hour with full menu of assays, including Therapeutic Drug Monitoring and Drugs of Abuse." .

SCR:019617 a NLX:63400,
        owl:NamedIndividual ;
    oboInOwl:hasDbXref "Model_Number_AX-4030" ;
