    rdfs:label "FusionHunter" ;
    NIFRID:synonym "FusionHunter: identifying fusion transcripts using paired-end RNA-seq" ;
    definition: "Software for identifying fusion transcripts using paired-end RNA-seq." .

SCR:011896 a NLX:63400,
