    rdfs:label "mCSM" ;
    NIFRID:synonym "mCSM: predicting the effect of mutations in proteins using graph-based signatures" ;
    definition: "Data analysis service to the study of missense mutations which relies on graph-based signatures." .

SCR:010777 a NLX:63400,
        owl:NamedIndividual ;
    oboInOwl:hasDbXref "biotools:mutation_taster",
        "OMICS_00153" ;
