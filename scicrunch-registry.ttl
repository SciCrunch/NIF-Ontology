    NIFRID:synonym "Mayo Clinic Florida",
        "Mayo Clinic in Florida",
        "Mayo Clinic in Jacksonville Florida",
        "Mayo Clinic Jacksonville" ;
    definition: "Mayo Clinic Florida is a comprehensive medical center belonging to the Mayo Clinic in Jacksonville, Florida. It is one of three Mayo campuses along with Phoenix/Scottsdale, Arizona and Rochester, Minnesota." .

SCR:011386 a NLX:152328,
