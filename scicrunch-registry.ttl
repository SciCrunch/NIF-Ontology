    rdfs:label "Genomatix Solutions" ;
    definition: "With their unique combination of proprietary algorithms and comprehensive data background, all our solutions do more than enable you to efficiently and effectively analyze and interpret biological data., THIS RESOURCE IS NO LONGER IN SERVICE. Documented on September 16,2025." .

SCR:011856 a NLX:152342,
        owl:NamedIndividual ;
