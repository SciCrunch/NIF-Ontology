    rdfs:label "U.S. Department of Defense" ;
    NIFRID:synonym "Department of Defense",
        "United States Department of Defense",
        "US Department of Defense" ;
    NIFRID:abbrev "DOD" ;
    definition: "Executive branch department of the federal government charged with coordinating and supervising all agencies and functions of the government directly related to national security and the United States Armed Forces." .

