    NIFRID:synonym "ngsplot",
        "ngsplot - Quick mining and visualization of next-generation sequencing data by integrating genomic databases" ;
    definition: "A software program that allows you to easily visualize your next-generation sequencing (NGS) samples at functional genomic regions." .

SCR:011796 a NLX:63400,
        owl:NamedIndividual ;
    oboInOwl:hasDbXref "OMICS_00925" ;
    rdfs:label "UCSC Cancer Genomics Browser" ;
    NIFRID:abbrev "Cancer Genomics Browser" ;
    definition: "A suite of web-based tools to visualize, integrate and analyze cancer genomics and its associated clinical data. It is possible to display your own clinical data within one of their datasets." .

SCR:011797 a NLX:63400,
        owl:NamedIndividual ;
