    rdfs:label "Northeastern University; Massachusetts; USA" ;
    NIFRID:synonym "Northeastern",
        "Northeastern University" ;
    NIFRID:abbrev "NEU" ;
    definition: "Private research university in Boston, Massachusetts. Established in 1898, the university offers undergraduate and graduate programs." .

