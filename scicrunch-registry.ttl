    NIFRID:synonym "MoDIL: Detecting INDEL Variation with Clone-end Sequencing" ;
    definition: "Software for a novel method for finding medium sized indels from high throughput sequencing datasets." .

SCR:010765 a NLX:63400,
        owl:NamedIndividual ;
    oboInOwl:hasDbXref "biotools:misa",
        "OMICS_00110" ;
    rdfs:label "MISA" ;
    NIFRID:synonym "MISA - MIcroSAtellite identification tool" ;
