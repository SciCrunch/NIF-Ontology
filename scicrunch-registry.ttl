    rdfs:label "JHU Deep Sequencing and Microarray Core" ;
    NIFRID:synonym "Johns Hopkins University Deep Sequencing and Microarray Core" ;
    definition: "Our aim is to provide cost-effective and time-efficient access to cutting-edge genomic technologies and expert assistance with experimental design and data analysis." .

SCR:011046 a NLX:63400,
        owl:NamedIndividual ;
    oboInOwl:hasDbXref "SciEx_981" ;
