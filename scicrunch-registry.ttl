    NIFRID:synonym "Loom Python",
        "Loompy v2.0",
        "Loompy v2.0.14",
        "LoomPython" ;
    definition: "Python implementation of the Loom file format to store and organize very large omics datasets, consisting of a main matrix, optional additional layers, a variable number of row and column annotations and sparse graph objects. Used to store single-cell gene expression data. Official Python library (API) used to create, read, and manipulate .loom files, supporting out-of-memory operations to handle datasets larger than RAM." .

SCR:016668 a NLX:63400,
        owl:NamedIndividual ;
