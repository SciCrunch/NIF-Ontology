    definition: "Hematology analyzer helps low volume laboratory enhance patient care." .

SCR:019639 a NLX:63400,
        owl:NamedIndividual ;
    oboInOwl:hasDbXref "Model_Number_Gallios" ;
    rdfs:label "Beckman Coulter | Gallios Flow Cytometer" ;
