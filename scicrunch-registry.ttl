    rdfs:label "California Polytechnic State University; California; USA" ;
    NIFRID:synonym "California Polytechnic State University" ;
    NIFRID:abbrev "Cal Poly" ;
    definition: "Nationally ranked, four-year, comprehensive public university located in San Luis Obispo, California." .

SCR:011129 a NLX:152328,
        owl:NamedIndividual ;
    oboInOwl:hasDbXref "Crossref funder ID:100009973",
        "grid.253554.0",
        "ISNI:0000 0000 9777 9241",
