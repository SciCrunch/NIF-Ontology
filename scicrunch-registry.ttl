SCR:011935 a NLX:63400,
        owl:NamedIndividual ;
    oboInOwl:hasDbXref "OMICS_01491" ;
    rdfs:label "MGC" ;
    definition: "A software application for finding complete and incomplete genes in metagenomic reads." .

SCR:011936 a NLX:63400,
        owl:NamedIndividual ;
