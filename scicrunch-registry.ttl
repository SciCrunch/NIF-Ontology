    definition: "HEMAVET 950FS can perform automated blood counts including; hemoglobin, hematocrit, white blood cells, platelets, differentials, and red blood cell indices for six animals." .

SCR:020017 a NLX:63400,
        owl:NamedIndividual ;
    oboInOwl:hasDbXref "Model_Number_2030i" ;
