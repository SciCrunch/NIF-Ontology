        "SCR_018300" ;
    rdfs:label "Washington University School of Medicine Genome Technology Access Center Core Facility" ;
    NIFRID:synonym "Genome Technology Access Center",
        "McDonnell Genome Institute Genome Technology Access Center",
        "Washington University in St. Louis Genome Technology Access Center",
        "Washington University in St. Louis McDonnell Genome Institute Genome Technology Access Center",
