        "OMICS_01321" ;
    rdfs:label "KisSplice" ;
    definition: "Software tool that enables analysis of RNA-seq data with or without reference genome.  Local transcriptome assembler for SNPs, indels and AS events." .

SCR:011894 a NLX:63400,
        owl:NamedIndividual ;
